<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace></RootNamespace>
    <NoWarn>$(NoWarn);CS0649;CS0169;CA1050;CA1822;CA1812</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common" />

    <!--
      ⚠ Not used by any target. These exist only to pin Nuke.Common's vulnerable transitives
      forward; see the note in Directory.Packages.props. Removing Nuke.Common removes the need
      for both. `dotnet list package` with the vulnerable and include-transitive flags is the check.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="NuGet.Packaging" />
  </ItemGroup>

</Project>
