<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Project loading (ADR-007), the analyzer host, the incremental cache, and the implementations
    behind `skala check`, `verify`, `fix` and `explain`.

    ⚠ It references Reporting and not the other way round. Analysis produces a RunReport; Reporting
    renders one. That direction is what makes docs/plan/09's "no renderer contains analysis logic" a
    compile-time fact.
  -->

  <PropertyGroup>
    <RootNamespace>Rikarin.Skala.Analysis</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!--
      The supported distribution of Roslyn's IDE code-style analyzers and fixes. It has analyzer
      assets only, so Skala copies those assemblies beside the host and loads just IDE1006 itself;
      referencing it as an analyzer here would run the entire IDE rule set while building Skala.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle"
                      GeneratePathProperty="true"
                      PrivateAssets="all"
                      ExcludeAssets="all" />
    <!--
      The CodeStyle package is analyzer-only and consequently declares no runtime dependencies.
      Its 5.9 fixer assemblies nevertheless reference Microsoft.Bcl.AsyncInterfaces 10.0.1. Keep
      that implementation dependency inside the same isolated payload instead of relying on a host
      (the test host happened to carry it; the standalone CLI correctly did not).
    -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces"
                      GeneratePathProperty="true"
                      PrivateAssets="all"
                      ExcludeAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="MSBuild.StructuredLogger" />
    <PackageReference Include="System.IO.Hashing" />

    <!--
      ⚠ ExcludeAssets=runtime on the Microsoft.Build.* four, and it is not an optimisation.
      MSBuildLocator's whole job is to make the *SDK's* MSBuild win; shipping our own copies beside
      it is the documented way to get an assembly-load failure that names a file which is obviously
      present.

      ⚠ **`Microsoft.CodeAnalysis.Workspaces.MSBuild` is not one of them, and treating it as one
      broke the workspace load mode outright.** It is Roslyn's, not MSBuild's; the SDK does not ship
      it, so MSBuildLocator's resolver has nothing to hand back and nothing else ever puts it beside
      the tool. Excluding it produced exactly the failure the exclusion above exists to prevent, one
      package too far over: `MSBuildWorkspace.Create()` threw
      "Could not load file or assembly 'Microsoft.CodeAnalysis.Workspaces.MSBuild'" for every
      `skala check` run in workspace mode that has ever shipped. The rule is the assembly's
      *publisher*, not its name: MSBuild's own assemblies come from the SDK, Roslyn's come from us.
    -->
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Core/Rikarin.Skala.Core/Rikarin.Skala.Core.csproj" />
    <ProjectReference Include="../../Formatting/Rikarin.Skala.Formatting.CSharp/Rikarin.Skala.Formatting.CSharp.csproj" />
    <ProjectReference Include="../../Reporting/Rikarin.Skala.Reporting/Rikarin.Skala.Reporting.csproj" />
    <ProjectReference Include="../../Rules/Rikarin.Skala.Rules/Rikarin.Skala.Rules.csproj" />
    <ProjectReference Include="../../Rules/Rikarin.Skala.Rules.Metadata/Rikarin.Skala.Rules.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_CodeAnalysis_CSharp_CodeStyle)/analyzers/dotnet/cs/*.dll"
          Link="RoslynCodeStyle/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Bcl_AsyncInterfaces)/lib/netstandard2.0/Microsoft.Bcl.AsyncInterfaces.dll"
          Link="RoslynCodeStyle/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
