<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The thin client. docs/plan/13 § "Startup", mitigation 2.

    ⚠ It references Rikarin.Skala.Protocol and NOTHING ELSE, and that is the entire design. The
    measurement that forced it: `skala daemon status` — a command that does no work at all — costs
    95 ms median on the reference machine, because the single `skala` executable references
    Rikarin.Skala.Analysis and therefore loads Roslyn before Main runs. The warm single-file budget
    for the whole operation is 40 ms. No amount of daemon-side work can pay that back; the client
    itself had to stop being expensive.

    ⚠ Roslyn is not AOT-friendly and this project must never reference it, directly or transitively.
    `IlcTreatWarningsAsErrors` and the trim analyzers are on so that a reference that would break
    AOT fails the build here rather than at publish time on somebody's CI.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rikarin.Skala.Client</RootNamespace>

    <!--
      ⚠ The published binary is `skala`: the client is what a hook, an editor and a person invoke,
      and the full tool becomes `skala-tool` beside it. In a plain `dotnet build` this produces a
      second `skala` under this project's own bin/, which is why SkalaClientPath (Directory.Build.targets
      of the publish layout) and the tests locate it by project rather than by name.
    -->
    <AssemblyName>skala</AssemblyName>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- ⚠ The client's whole job is to start fast and exit. Nothing it does is parallel. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- Size, which is start time: every page faulted in before Main is part of the budget. -->
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>

    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!--
    ⚠ **This project, and not Rikarin.Skala.Cli, produces the `Rikarin.Skala.Cli` tool package.**

    The tool command has to *be* the AOT client, or the client is not on the path a hook takes and
    the 8.65 ms warm number does not exist for anybody who installed from NuGet. A .NET tool's
    command is its entry point, and an entry point is either a managed assembly run through the
    muxer (`Runner="dotnet"`) or a native executable (`Runner="executable"`, RID-specific, new in
    .NET 10). Only the second can be this binary, and only the project that produces the binary can
    declare it. So the package is built here and the full tool is payload beside it — which is also
    the layout `Fallback.Locate` already looks for.

    ⚠ Superseded comment, kept because it was true until this milestone and its reasoning is not:
    Rikarin.Skala.Cli's own .csproj said "NativeAOT cannot be packed as a dotnet tool, so the client
    is a standalone-binary concern" and concluded that a global install correctly has the old
    startup cost. That was right for `Runner="dotnet"` and is wrong for .NET 10: measured on
    10.0.400, `dotnet pack` on an AOT project with a RuntimeIdentifier emits
    `tools/any/<rid>/DotnetToolSettings.xml` with `Runner="executable"`, and
    `dotnet tool install` with the global switch links the shim straight at the native binary.
    (An XML comment cannot contain a double hyphen, which is why no switch is spelled out here.)

    ⚠ And the thing that makes the whole arrangement work, measured rather than assumed:
    `dotnet tool install` puts a **symlink** in `~/.dotnet/tools/` pointing into the package store,
    and `Environment.ProcessPath` resolves it — it reports
    `~/.dotnet/tools/.store/…/tools/any/osx-arm64/skala`, not the symlink. `Fallback.Locate` looks
    beside `Environment.ProcessPath` first, so it finds the `skala-tool` this package shipped and
    not one that happens to be on the PATH. Had ProcessPath reported the symlink, "beside" would
    have been `~/.dotnet/tools/`, the tool would not be there, and every command that is not a warm
    single-file format would have failed with exit 5.
  -->
  <PropertyGroup>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <PackageId>Rikarin.Skala.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skala</ToolCommandName>
    <Description>The `skala` tool: a NativeAOT front end that answers a warm single-file format in single-digit milliseconds, with the full tool shipped beside it for everything else.</Description>
    <PackageTags>formatting;analyzers;editorconfig;dotnet-tool;skala</PackageTags>

    <!-- The dSYM bundle is 5 MB of debug information nobody installing a tool wants. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rikarin.Skala.Protocol/Rikarin.Skala.Protocol.csproj" />
  </ItemGroup>

  <!--
    The full tool, published by `./build.sh Pack` into a staging directory and handed here.

    ⚠ Staged by the build rather than published from inside this .csproj on purpose. A nested
    `dotnet publish` inside pack is a second evaluation of the whole project graph in the middle of
    the first one; it deadlocks under `/m`, it does not respect the no-build switch, and its failures
    surface as a pack error with no project name in it. The build target does the two publishes in
    order — full tool first, because the client is useless without something to fall back to — and
    pack is then only a copy.
  -->
  <ItemGroup Condition="'$(SkalaToolPayload)' != ''">
    <!--
      ⚠ `.pdb` is excluded, and not only to keep the download down. The AOT publish carries
      `Rikarin.Skala.Protocol.pdb` — the client's own reference — into the package, and the tool
      payload carries a second copy of the same name; NuGet's NU5118 for that is a warning, and
      TreatWarningsAsErrors turns it into a pack that fails outright. Nothing in a global tool
      install reads a portable pdb anyway.

      ⚠ The client's own binary is excluded too, though the payload never contains one: `skala` and
      `skala-tool` are two names for a reason, and if a stale publish ever put a `skala` in the
      payload it would land on top of the AOT binary the package exists to ship, silently.
    -->
    <!--
      ⚠ `PackagePath` ends with a separator and carries no `%(RecursiveDir)`, which looks like it
      loses the subdirectories and does the opposite. NuGet's pack logic appends `RecursiveDir` to a
      directory-shaped PackagePath itself — the SDK's own `PackTool` target says so in a comment —
      so spelling it out produces `BuildHost-net472/BuildHost-net472/…` and `zh-Hans/zh-Hans/…`.
      Measured: 19 files landed one level too deep before this was removed.
    -->
    <None Include="$(SkalaToolPayload)/**/*"
          Exclude="$(SkalaToolPayload)/skala;$(SkalaToolPayload)/skala.exe;$(SkalaToolPayload)/**/*.pdb;$(SkalaToolPayload)/**/*.dSYM/**/*"
          Pack="true"
          PackagePath="tools/any/$(RuntimeIdentifier)/"
          Visible="false" />
  </ItemGroup>

  <!--
    ⚠ The client's own publish output is collected by the SDK's `PackTool` as `$(PublishDir)/**/*`,
    which on macOS includes a 13 MB `skala.dSYM` bundle — a third of the whole package, for symbols
    nothing in a tool install can read. It is there *because* `StripSymbols` is on and the 2.9 MB
    binary is small; the bundle is the part that was taken out. `PackTool` builds its item list
    inside itself and returns it, so there is nothing to filter afterwards — the publish directory
    has to be clean before it looks.

    Conditioned on SkalaToolPayload, which only the packaging run sets, so `./build.sh Native` and
    an ordinary `dotnet publish` keep their symbols.

    ⚠ `AfterTargets="Publish"` was the obvious hook and does not work — the bundle is still in the
    package. `dsymutil` runs after the `Publish` target on this SDK. `PackToolImplementation` is the
    last of `PackTool`'s dependencies, so hooking after it is the one point that is provably between
    a finished publish and the glob that reads it.
  -->
  <Target Name="SkalaDropSymbolsBeforePacking"
          AfterTargets="PackToolImplementation"
          Condition="'$(SkalaToolPayload)' != ''">

    <ItemGroup>
      <_SkalaSymbolFiles Include="$(PublishDir)**/*.dSYM/**/*" />
      <_SkalaSymbolFiles Include="$(PublishDir)**/*.pdb" />
      <_SkalaSymbolDirectories Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)', '*.dSYM'))" />
    </ItemGroup>

    <Delete Files="@(_SkalaSymbolFiles)" />
    <RemoveDir Directories="@(_SkalaSymbolDirectories)" />
  </Target>

  <!--
    ⚠ A package that installs and cannot do anything but format one warm file is the exact failure
    this milestone exists to catch, and it is silent: `Fallback.Locate` returns null, every other
    command exits 5, and the package looked fine on the machine that built it because the repository
    was beside it. So packing without the payload is an error rather than a smaller .nupkg.
  -->
  <Target Name="SkalaVerifyToolPayload" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' == ''"
           Text="Rikarin.Skala.Cli is a RID-specific tool package (the command is a NativeAOT binary). Pack it with -r &lt;rid&gt;, or run `./build.sh Pack`." />
    <Error Condition="'$(SkalaToolPayload)' == '' or !Exists('$(SkalaToolPayload)/skala-tool.dll')"
           Text="No skala-tool payload at '$(SkalaToolPayload)'. The tool package must ship the full tool beside the client, or every command that is not a warm single-file format exits 5. Run `./build.sh Pack`." />
  </Target>

</Project>
