<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The `skala` tool, and the `Rikarin.Skala.Cli` package. Argument parsing and rendering only:
    every command's logic lives in Rikarin.Skala.Core so that MSBuild, MCP and the LSP server can
    host it (docs/plan/02 § project graph).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rikarin.Skala.Cli</RootNamespace>
    <!--
      ⚠ `skala`, and it is the tool package's command.

      It was `skala-tool` from M7 until the daemon was deleted: a NativeAOT thin client
      (Tools/Rikarin.Skala.Client) published as `skala`, this published beside it as the payload it
      fell back to, and the two needed two names because they had to sit in one directory. The
      client existed for one number — a warm single-file format inside 40 ms, which needed the
      79.5 ms framework-dependent start to be paid once instead of per invocation. With no
      format-on-save consumer and no interactive latency requirement, nothing was buying that
      number, and the client, the daemon and the protocol went together.

      ⚠ So the package is an ordinary portable `PackAsTool` again — `Runner="dotnet"`,
      RID-agnostic, one .nupkg that installs everywhere — rather than the RID-specific
      `Runner="executable"` shape the AOT command forced. Simpler, and it installs on RIDs nobody
      built for.
    -->
    <AssemblyName>skala</AssemblyName>

    <!-- Directory.Build.props defaults every project to unpackable; this is one of the five that is. -->
    <IsPackable>true</IsPackable>
    <PackageId>Rikarin.Skala.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skala</ToolCommandName>
    <Description>The `skala` tool: one configuration, the same formatting and analysis from the CLI, MSBuild, an editor and CI.</Description>
    <PackageTags>formatting;analyzers;editorconfig;dotnet-tool;skala</PackageTags>

    <!--
      Measured, not assumed. `format check` over Vixen (4 708 files) with the workstation GC and
      ten-way parallelism is 19.5 s of wall time for 69 s of CPU: the collector, not the formatter,
      is the contended resource once ten threads are each building a ~40 000-node document. The
      server GC takes the same run to 10.9 s. Sequential it is 30.9 s, so the parallelism is worth
      2.8× and the GC choice is worth another 1.8× on top of it (docs/plan/13 § "Parallelism").
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!--
      ⚠ ReadyToRun. Precompiled native code for the framework-dependent tool: it cuts the JIT cost
      on the first analysis, and it does not make the tool small. Only meaningful with a
      RuntimeIdentifier, so it is conditioned on one rather than set unconditionally — `dotnet
      build` with no RID would otherwise warn on every build, and the tool package is RID-agnostic
      and does not get it at all.
    -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(RuntimeIdentifier)' != ''">false</PublishReadyToRunComposite>

    <!--
      ⚠ English only, which is not a decision about users: `InvariantGlobalization` is already true
      above, so the localised Roslyn and System.CommandLine resources are 6.6 MB of assemblies this
      process will never load. Measured on the tool package when it still shipped the AOT client:
      148 files and 38 256 614 bytes before, 79 files and 32 929 798 bytes after.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Analysis/Rikarin.Skala.Analysis/Rikarin.Skala.Analysis.csproj" />
    <ProjectReference Include="../../Core/Rikarin.Skala.Core/Rikarin.Skala.Core.csproj" />
    <ProjectReference Include="../Rikarin.Skala.Mcp/Rikarin.Skala.Mcp.csproj" />
    <ProjectReference Include="../../Reporting/Rikarin.Skala.Reporting/Rikarin.Skala.Reporting.csproj" />
    <ProjectReference Include="../../Formatting/Rikarin.Skala.Formatting.CSharp/Rikarin.Skala.Formatting.CSharp.csproj" />
    <ProjectReference Include="../Rikarin.Skala.Server/Rikarin.Skala.Server.csproj" />
  </ItemGroup>

</Project>
