<Project>

  <!--
    The build integration. docs/plan/11-cli-and-integrations.md § "MSBuild".

    ⚠ There is no MSBuild *task assembly* here, and that is a decision rather than an omission.
    A task would have to load into MSBuild's own process on three hosts (`dotnet build`, MSBuild.exe
    under Visual Studio, and Rider's build host), which means netstandard2.0, a pinned
    Microsoft.Build.Utilities.Core, and a load failure that breaks every project in the repository at
    once. Everything it would do is start `skala` and read an exit code, which `Exec` already does —
    and doc 11's first line says the CLI is the contract and nothing may have behaviour it does not.
    A task that shells out is a second place for the argument list to be wrong.
    docs/plan/02 § "Package boundaries" records the same decision.

    ⚠ No SK id is emitted from here. The SK9000 register lives in docs/plan/08 and ADR-012 makes
    every entry permanent; the tool that actually finds the problem prints its own ids, and a
    second, MSBuild-side numbering of "the tool said no" would be an id with no rule behind it.
  -->

  <!--
    ⚠ Resolution is in a target rather than in the .props because a tool manifest can be restored
    between evaluation and execution — `dotnet tool restore` as a CI step, or the first build after
    a clone. Properties inside a target are evaluated when the target runs.
  -->
  <Target Name="SkalaResolveTool">
    <PropertyGroup>
      <!--
        ⚠ The manifest is used only if it actually lists `skala`. A repository with a manifest for
        something else entirely would otherwise get `dotnet tool run skala`, which fails with exit
        code 1 — the same code `format --check` uses for "this file needs formatting".
      -->
      <_SkalaManifestFile Condition="'$(SkalaToolManifestDirectory)' != ''">$(SkalaToolManifestDirectory)/.config/dotnet-tools.json</_SkalaManifestFile>
      <_SkalaManifestHasTool Condition="'$(_SkalaManifestFile)' != '' and Exists('$(_SkalaManifestFile)')">$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(_SkalaManifestFile)')), '&quot;skala&quot;'))</_SkalaManifestHasTool>

      <_SkalaExecutable Condition="'$(SkalaToolPath)' != ''">$(SkalaToolPath)</_SkalaExecutable>
      <_SkalaPrefix Condition="'$(SkalaToolPath)' != ''"></_SkalaPrefix>
      <_SkalaSource Condition="'$(SkalaToolPath)' != ''">SkalaToolPath</_SkalaSource>

      <!--
        ⚠ The pinned form, and the one doc 11 § "Distribution" recommends: a formatter whose version
        drifts between developers reformats the tree back and forth, and only a manifest stops it.
        `dotnet tool run` resolves against the manifest above the working directory, so the working
        directory becomes the manifest's own — a project built from elsewhere would otherwise miss it.
      -->
      <_SkalaExecutable Condition="'$(_SkalaExecutable)' == '' and '$(_SkalaManifestHasTool)' == 'true'">dotnet</_SkalaExecutable>
      <_SkalaPrefix Condition="'$(_SkalaPrefix)' == '' and '$(_SkalaManifestHasTool)' == 'true'">tool run skala --</_SkalaPrefix>
      <_SkalaSource Condition="'$(_SkalaSource)' == '' and '$(_SkalaManifestHasTool)' == 'true'">$(_SkalaManifestFile)</_SkalaSource>

      <!-- A global install. Works, unpinned, and the exit code is the only way to find out it is absent. -->
      <_SkalaExecutable Condition="'$(_SkalaExecutable)' == ''">skala</_SkalaExecutable>
      <_SkalaSource Condition="'$(_SkalaSource)' == ''">PATH</_SkalaSource>

      <_SkalaWorkingDirectory Condition="'$(_SkalaManifestHasTool)' == 'true'">$(SkalaToolManifestDirectory)</_SkalaWorkingDirectory>
      <_SkalaWorkingDirectory Condition="'$(_SkalaWorkingDirectory)' == ''">$(MSBuildProjectDirectory)</_SkalaWorkingDirectory>

      <_SkalaCommon>--no-color</_SkalaCommon>
      <_SkalaCommon Condition="'$(SkalaArguments)' != ''">$(_SkalaCommon) $(SkalaArguments)</_SkalaCommon>
    </PropertyGroup>

    <Message Importance="low"
             Text="Skala: $(_SkalaExecutable) $(_SkalaPrefix) (from $(_SkalaSource)), mode $(SkalaMode), gate $(SkalaGate)." />
  </Target>

  <!--
    ⚠ The cheap half, and the one that is ON in the inner loop.

    `format --check` over a project's own sources is seconds — single-digit milliseconds per file
    with a warm daemon. That is the half a developer can afford on every `dotnet build`.
  -->
  <Target Name="SkalaFormatCheck"
          AfterTargets="Build"
          DependsOnTargets="SkalaResolveTool"
          Condition="'$(SkalaEnabled)' == 'true' and '$(SkalaMode)' != 'format' and '$(DesignTimeBuild)' != 'true'">

    <Exec Command="&quot;$(_SkalaExecutable)&quot; $(_SkalaPrefix) format --check --quiet $(_SkalaCommon) &quot;$(SkalaPaths)&quot;"
          WorkingDirectory="$(_SkalaWorkingDirectory)"
          StandardOutputImportance="normal"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_SkalaExit" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_SkalaConsole" />
    </Exec>

    <PropertyGroup>
      <_SkalaWhat>`format --check`</_SkalaWhat>
      <!--
        1 is `FormatCommand.ChangesFound` and 2 is `FormatCommand.Failed` — the formatter's own
        pair, which is NOT ExitCodes.FormattingNeeded, also 2, used by `check`. `--check` exiting 1
        is the contract the README states and the pre-commit hook reads.
      -->
      <_SkalaFinding>files under $(SkalaPaths) are not formatted. Run `skala format` to fix them</_SkalaFinding>
      <_SkalaFindingExit>1</_SkalaFindingExit>
      <_SkalaHardExit>2</_SkalaHardExit>
    </PropertyGroup>

    <CallTarget Targets="_SkalaInterpret" />
  </Target>

  <!--
    ⚠ The expensive half, and the one that is OFF in the inner loop.

    The reasoning is doc 11's and it is why this package has a mode at all: analysis costs minutes,
    `dotnet build` is run constantly, and a build tool that triples build time gets disabled by
    whoever is in a hurry — permanently, in a Directory.Build.props nobody revisits. CI sets
    SkalaMode=check; a developer gets formatting verification only, which is seconds.

    The analyzer package (Rikarin.Skala.Rules) is the other half and it *does* run in every build,
    because that is what analyzers are for and the compiler has already paid for the tree walk.
  -->
  <Target Name="SkalaCheck"
          AfterTargets="Build"
          DependsOnTargets="SkalaResolveTool"
          Condition="'$(SkalaEnabled)' == 'true' and '$(SkalaMode)' == 'check' and '$(DesignTimeBuild)' != 'true'">

    <PropertyGroup>
      <_SkalaCheckArguments>check --gate $(SkalaGate) $(_SkalaCommon)</_SkalaCheckArguments>
      <_SkalaCheckArguments Condition="'$(SkalaSarifOutput)' != ''">$(_SkalaCheckArguments) --format sarif --output &quot;$(SkalaSarifOutput)&quot;</_SkalaCheckArguments>
    </PropertyGroup>

    <Exec Command="&quot;$(_SkalaExecutable)&quot; $(_SkalaPrefix) $(_SkalaCheckArguments) &quot;$(SkalaPaths)&quot;"
          WorkingDirectory="$(_SkalaWorkingDirectory)"
          StandardOutputImportance="high"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_SkalaExit" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_SkalaConsole" />
    </Exec>

    <PropertyGroup>
      <_SkalaWhat>`check --gate $(SkalaGate)`</_SkalaWhat>
      <_SkalaFinding>the `$(SkalaGate)` gate failed. Run `skala check --gate $(SkalaGate)` for the findings</_SkalaFinding>
      <_SkalaFindingExit>1</_SkalaFindingExit>
      <_SkalaHardExit>2</_SkalaHardExit>
    </PropertyGroup>

    <CallTarget Targets="_SkalaInterpret" />
  </Target>

  <!--
    ⚠ `format`, which rewrites files, is opt-in and is never reached by the two targets above.

    A build that edits the tree it is building dirties the worktree, invalidates its own incremental
    state, changes a file the IDE has open, and races when two projects share a directory. It exists
    so that a repository which wants it need not write the Exec by hand; the conditions are shaped so
    that turning it on turns the check off, and the two can never both run.
  -->
  <Target Name="SkalaFormat"
          AfterTargets="Build"
          DependsOnTargets="SkalaResolveTool"
          Condition="'$(SkalaEnabled)' == 'true' and '$(SkalaMode)' == 'format' and '$(DesignTimeBuild)' != 'true'">

    <Exec Command="&quot;$(_SkalaExecutable)&quot; $(_SkalaPrefix) format $(_SkalaCommon) &quot;$(SkalaPaths)&quot;"
          WorkingDirectory="$(_SkalaWorkingDirectory)"
          StandardOutputImportance="normal"
          ConsoleToMSBuild="true"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_SkalaExit" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_SkalaConsole" />
    </Exec>

    <PropertyGroup>
      <_SkalaWhat>`format`</_SkalaWhat>
      <!-- Writing, so 1 means "files were rewritten", which is the point and not a finding. -->
      <_SkalaFindingExit>none</_SkalaFindingExit>
      <_SkalaHardExit>2</_SkalaHardExit>
    </PropertyGroup>

    <CallTarget Targets="_SkalaInterpret" />
  </Target>

  <!--
    One place that turns an exit code into a diagnostic, because three copies of this ladder is
    three chances to get a code wrong.

    ⚠ "The tool is missing" is detected from the *output* and not only from the exit code, and it has
    to be. A missing executable is 127 under `sh` and 9009 under `cmd`, but an unrestored tool
    manifest makes `dotnet tool run skala` exit **1** — the same code `format --check` uses for
    "this file needs formatting". Reporting that as a formatting failure sends someone to look at a
    file that is fine.
  -->
  <Target Name="_SkalaInterpret">
    <PropertyGroup>
      <_SkalaMissing>false</_SkalaMissing>
      <_SkalaMissing Condition="'$(_SkalaExit)' == '127' or '$(_SkalaExit)' == '9009'">true</_SkalaMissing>
      <_SkalaMissing Condition="'$(_SkalaExit)' != '0' and $(_SkalaConsole.Contains('dotnet tool restore'))">true</_SkalaMissing>
      <_SkalaMissing Condition="'$(_SkalaExit)' != '0' and $(_SkalaConsole.Contains('command not found'))">true</_SkalaMissing>
      <_SkalaMissing Condition="'$(_SkalaExit)' != '0' and $(_SkalaConsole.Contains('is not recognized'))">true</_SkalaMissing>

      <_SkalaMissingText>Skala: cannot run `$(_SkalaExecutable) $(_SkalaPrefix)` (resolved from $(_SkalaSource)). Install it with `dotnet tool install --local Rikarin.Skala.Cli` followed by `dotnet tool restore`, set SkalaToolPath, or set SkalaEnabled=false.</_SkalaMissingText>
    </PropertyGroup>

    <!--
      ⚠ A warning, not an error, unless the repository asks otherwise. This package is imported by a
      Directory.Build.props that every project inherits, including on a machine that has just cloned
      the repository and not run `dotnet tool restore`. Failing there means the first thing Skala
      does to a new contributor is break `dotnet build`, and the second is get removed.
    -->
    <Warning Condition="'$(_SkalaMissing)' == 'true' and '$(SkalaRequireTool)' != 'true'"
             File="$(MSBuildProjectFullPath)" Text="$(_SkalaMissingText)" />
    <Error Condition="'$(_SkalaMissing)' == 'true' and '$(SkalaRequireTool)' == 'true'"
           File="$(MSBuildProjectFullPath)" Text="$(_SkalaMissingText)" />

    <Warning Condition="'$(_SkalaMissing)' != 'true' and '$(_SkalaExit)' == '$(_SkalaFindingExit)' and '$(SkalaTreatFindingsAsErrors)' != 'true'"
             File="$(MSBuildProjectFullPath)" Text="Skala: $(_SkalaFinding)." />
    <Error Condition="'$(_SkalaMissing)' != 'true' and '$(_SkalaExit)' == '$(_SkalaFindingExit)' and '$(SkalaTreatFindingsAsErrors)' == 'true'"
           File="$(MSBuildProjectFullPath)" Text="Skala: $(_SkalaFinding)." />

    <!--
      3 configuration · 4 load · 5 internal, and 2 is the command's own hard failure. None of them
      is a finding, and none of them gates the build: a tool that cannot run is not evidence about
      the code. Say so loudly enough to be fixed.
    -->
    <Warning Condition="'$(_SkalaMissing)' != 'true' and ('$(_SkalaExit)' == '$(_SkalaHardExit)' or '$(_SkalaExit)' == '3' or '$(_SkalaExit)' == '4' or '$(_SkalaExit)' == '5')"
             File="$(MSBuildProjectFullPath)"
             Text="Skala: $(_SkalaWhat) could not complete (exit $(_SkalaExit) — 2 failed, 3 configuration, 4 load, 5 internal). The build is not gated on it." />
  </Target>

</Project>
