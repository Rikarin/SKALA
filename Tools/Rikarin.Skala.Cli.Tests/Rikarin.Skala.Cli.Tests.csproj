<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ⚠ Nothing references Cli (docs/plan/02). These tests drive the built `skala` binary as a
    process; the reference guard in Rikarin.Skala.Core.Tests asserts the missing edge stays missing.
  -->

  <ItemGroup>
    <ProjectReference Include="../../Core/Rikarin.Skala.Core/Rikarin.Skala.Core.csproj" />

    <!--
      Build order only: ReferenceOutputAssembly="false" means no assembly reference is created, so
      the CLI's types are unreachable from here and the forbidden edge stays forbidden. It exists
      so that `dotnet test` on this project alone still has a `skala` binary to drive.
    -->
    <ProjectReference Include="../Rikarin.Skala.Cli/Rikarin.Skala.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SkalaCliAssembly"
                      Value="$(SkalaRepositoryRoot)Tools/Rikarin.Skala.Cli/bin/$(Configuration)/net10.0/skala.dll" />
  </ItemGroup>

</Project>
