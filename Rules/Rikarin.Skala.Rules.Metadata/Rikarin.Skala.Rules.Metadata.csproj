<Project Sdk="Microsoft.NET.Sdk">

  <!--
    rules.json and the catalogue generated from it. netstandard2.0, because Rikarin.Skala.Rules
    references it and that assembly loads into csc and into Rider (ADR-006).
  -->

  <PropertyGroup>
    <RootNamespace>Rikarin.Skala.Rules.Metadata</RootNamespace>
    <!-- The catalogue is the assembly's entire surface; being able to read the generated file matters. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rikarin.Skala.Rules.Generator/Rikarin.Skala.Rules.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="rules.json" />
    <!-- Shipped so `skala explain` and the docs generator can read provenance without a build. -->
    <EmbeddedResource Include="rules.json" LogicalName="Rikarin.Skala.Rules.Metadata.rules.json" />
  </ItemGroup>

</Project>
