root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = false
skala_insert_final_newline = false
indent_style = space
indent_size = 4

# Microsoft .NET properties
csharp_indent_braces = false
skala_indent_switch_labels = true
skala_new_line_before_catch = false
skala_new_line_before_else = false
skala_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_open_brace = none
csharp_new_line_between_query_expression_clauses = true
csharp_preferred_modifier_order = public, private, protected, internal, file, new, static, abstract, virtual, closed, sealed, readonly, override, safe, unsafe, extern, volatile, async, required:suggestion
csharp_prefer_braces = true:none
csharp_preserve_single_line_blocks = true
skala_space_after_cast = false
skala_space_after_colon_in_inheritance_clause = true
skala_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
skala_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
skala_space_before_colon_in_inheritance_clause = true
skala_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
skala_space_before_semicolon_in_for_statement = false
skala_space_within_array_rank_empty_brackets = false
skala_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
skala_space_between_method_call_parameter_list_parentheses = false
skala_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
skala_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_utf8_string_literals = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_using_directive_placement = outside_namespace:silent

