<Project>

  <!-- Central package management. Versions are the register in docs/plan/01-technology-decisions.md. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.10" />

    <!-- Project loading (ADR-007). The binlog path is primary; the workspace path is the fallback. -->
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.246" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />

    <!--
      ⚠ ExcludeAssets=runtime + PrivateAssets=all on every one of these, enforced by MSBL001.
      MSBuildLocator requires the SDK's copies to win at run time; ours are compile-time only.
    -->
    <PackageVersion Include="Microsoft.Build" Version="17.14.28" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.14.28" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="17.14.28" />

    <!-- Reporting (ADR-009) and the agent surface (ADR-014). -->
    <PackageVersion Include="Sarif.Sdk" Version="5.6.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />

    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />

    <!-- Build -->
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />

    <!-- Test -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

</Project>
