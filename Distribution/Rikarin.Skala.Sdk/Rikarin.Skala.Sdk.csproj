<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The meta package. docs/plan/02 § "Package boundaries": one `PackageReference` is the whole
    adoption of Skala in a new repository.

        PackageReference Include="Rikarin.Skala.Sdk" Version="[2.0.0-alpha.127]" PrivateAssets="all"

    ⚠ The square brackets are exact-version and they are load-bearing, not punctuation. A floating
    range puts a different analyzer on each developer's machine, and `SK0001` is "this file is not
    formatted" — so an analyzer at one version and a `skala` tool at another disagree about whether
    the tree is clean. docs/plan/18 § "What a consumer pins": all five packages ship at one version,
    so one number pins the whole surface, and the tool manifest must name the same one.

    brings the analyzers (SK diagnostics in the build and in Rider), the build integration
    (`format` with the check switch after Build; `check` when CI sets SkalaMode=check) and the canonical
    `.editorconfig` carrier with its 5 ms drift check.

    ⚠ It does not bring the *tool*. A `PackageReference` cannot install a .NET tool, and arranging
    for one to be downloaded behind a repository's back would defeat the version pinning doc 11
    § "Distribution" calls a correctness feature. `dotnet tool install` with the local switch is
    the second line of the adoption, and it is a line a person types on purpose.
  -->

  <PropertyGroup>
    <!--
      ⚠ netstandard2.0, and it is a compatibility declaration rather than a build target: there is
      no build output in this package. The dependency group's framework is what a consumer's restore
      matches against, and a `net10.0` group would make this package unreferenceable from the
      net8.0 and netstandard2.0 projects that a real repository still contains.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <PackageId>Rikarin.Skala.Sdk</PackageId>
    <Description>One PackageReference that adopts Skala: the SK analyzers, the MSBuild integration, and the canonical .editorconfig carrier, with starter files for a repository that has neither.</Description>
    <PackageTags>formatting;analyzers;editorconfig;msbuild;skala</PackageTags>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--
      ⚠ NU5129 is a convention warning and it is wrong about this package, but it is an error under
      TreatWarningsAsErrors and it broke `Pack` on all three runners. It fires because `build/`
      contains a .props file that is not `build/$(PackageId).props`, on the assumption that a .props
      NuGet does not auto-import is a .props nothing imports. `build/Rikarin.Skala.Sdk.RuleIds.props`
      is imported explicitly, by `build/Rikarin.Skala.Sdk.targets`, which NuGet does auto-import —
      and it has to stay a separate file for the reason the generator comment below gives: a list
      that lives in the .targets gets hand-maintained and gets merged twice, and both have happened.
      ⚠ Renaming it to the conventional name is not the fix: `buildTransitive` reaches it through
      that same relative import, and NuGet would then import it a second time on its own.
    -->
    <NoWarn>$(NoWarn);NU5128;NU5129</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PackageMarker.cs" />
  </ItemGroup>

  <!--
    ⚠ `PrivateAssets="none"` on all three, and it is load-bearing rather than tidiness. NuGet's
    default private set is `contentfiles;analyzers;build` — precisely the three asset kinds these
    packages consist of. With the default, a consumer of this meta package would restore three
    dependencies and receive nothing from any of them: no SK diagnostics, no build target, no
    canonical check. `PrivateAssets="none"` is what removes the `exclude="Build,Analyzers"` attribute
    from this package's own .nuspec dependencies. What it produces instead is `include="All"`, which
    is the attribute to look for when checking that this package still works.

    ⚠ `ReferenceOutputAssembly="false"` looks right here — this project compiles against none of the
    three — and it is wrong: measured, it drops the reference from the .nuspec entirely, and the
    dependency group comes out empty. A meta package with no dependencies installs cleanly, says
    nothing, and does nothing, which is the failure mode hardest to notice.
  -->
  <ItemGroup>
    <ProjectReference Include="../../Rules/Rikarin.Skala.Rules/Rikarin.Skala.Rules.csproj"
                      PrivateAssets="none" />
    <ProjectReference Include="../../Tools/Rikarin.Skala.MSBuild/Rikarin.Skala.MSBuild.csproj"
                      PrivateAssets="none" />
    <ProjectReference Include="../Rikarin.Skala.Canonical/Rikarin.Skala.Canonical.csproj"
                      PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="content/skala.editorconfig" Pack="true" PackagePath="content/" />
    <None Include="content/skala.jsonc" Pack="true" PackagePath="content/" />
    <None Include="build/Rikarin.Skala.Sdk.targets" Pack="true" PackagePath="build/" />
    <None Include="build/Rikarin.Skala.Sdk.RuleIds.props" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/Rikarin.Skala.Sdk.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!--
    ⚠ `<SkalaRuleIds>` is generated, and this target is the generator. It was a hand-typed
    semicolon-separated line for the whole of the catalogue's growth, and it failed in three
    distinct ways in one session: it sat at 36 ids while rules.json shipped 101; a merge produced
    two `<SkalaRuleIds>` elements, still well-formed XML, with MSBuild silently taking one; and it
    drifted on every single rule merge, so with ten concurrent branches it was both guaranteed to
    conflict and guaranteed to be stale in between. `rules.json` was already the single source for
    five other consumers. This is the sixth.

    ⚠ The regex is anchored at the start of a line rather than matching `"id"` anywhere, and that
    is the difference between a measurement and a coincidence: `rules.json` is pretty printed one
    property per line, `"resharperId"` does not match a pattern that requires the quote directly
    before `id`, and an `"id"` appearing inside a `rationale` string is escaped as a backslash quote
    and cannot start a line. Checked against a real JSON parse of the same file: the two agree on
    all 325 ids, in order.

    ⚠ Zero ids is an error, not an empty list. An empty `$(SkalaRuleIds)` produces a
    `WarningsNotAsErrors` that silences nothing, which turns the SkalaRulesAsErrors default —
    the flag-day escape hatch this package exists for — off, in silence, in every consumer.
  -->
  <UsingTask TaskName="SkalaGenerateRuleIdsTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <RulesJson ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var source = File.ReadAllText(RulesJson);
var ids = new SortedSet<string>(StringComparer.Ordinal);

foreach (Match match in Regex.Matches(source, "^[ \t]*\"id\"[ \t]*:[ \t]*\"(SK[0-9]+)\"", RegexOptions.Multiline))
{
    var id = match.Groups[1].Value;

    // SK0xxx is the formatter and SK9xxx is the tool talking about itself; neither reaches csc as
    // an analyzer diagnostic, so neither belongs in a warnaserror exclusion list.
    if (id.StartsWith("SK0", StringComparison.Ordinal) || id.StartsWith("SK9", StringComparison.Ordinal))
    {
        continue;
    }

    ids.Add(id);
}

if (ids.Count == 0)
{
    Log.LogError("SkalaGenerateRuleIds read no rule ids out of " + RulesJson + ". An empty <SkalaRuleIds> makes WarningsNotAsErrors silence nothing, which turns off the SkalaRulesAsErrors escape hatch in every consumer without saying so.");
}
else
{
    var lines = new[]
    {
        "<Project>",
        "",
        "  <!--",
        "    ⚠ GENERATED. Every build of Distribution/Rikarin.Skala.Sdk rewrites this file from",
        "    Rules/Rikarin.Skala.Rules.Metadata/rules.json — see the SkalaGenerateRuleIds target in",
        "    Rikarin.Skala.Sdk.csproj, and the comment above the import in build/Rikarin.Skala.Sdk.targets",
        "    for why the value is a list of ids at all. An edit here survives until the next build.",
        "",
        "    ⚠ It is a file of its own so that the list cannot be hand-maintained and cannot be merged",
        "    twice. Both have happened: the list sat at 36 ids while rules.json shipped 101, and a merge",
        "    once produced two SkalaRuleIds elements — well-formed XML, MSBuild silently taking one.",
        "    SdkAdoptionTests.RuleIds_MatchRulesJson and TheRuleIdList_IsDeclaredExactlyOnce assert both.",
        "  -->",
        "",
        "  <PropertyGroup>",
        "    <SkalaRuleIds>" + string.Join(";", new List<string>(ids).ToArray()) + "</SkalaRuleIds>",
        "  </PropertyGroup>",
        "",
        "</Project>",
        ""
    };

    // \n on every platform. The file is committed, git normalises this tree to LF, and a CRLF
    // rewrite on a Windows build would show the generated file as modified on every build.
    var generated = string.Join("\n", lines);

    if (!File.Exists(Destination) || !string.Equals(File.ReadAllText(Destination), generated, StringComparison.Ordinal))
    {
        File.WriteAllText(Destination, generated, new UTF8Encoding(false));
        Log.LogMessage(MessageImportance.High, "Skala: regenerated " + Destination + " with " + ids.Count + " rule ids from rules.json. Commit it.");
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SkalaGenerateRuleIds" BeforeTargets="BeforeBuild;SkalaValidatePackagedMSBuildFiles">
    <SkalaGenerateRuleIdsTask RulesJson="$(MSBuildThisFileDirectory)../../Rules/Rikarin.Skala.Rules.Metadata/rules.json"
                              Destination="$(MSBuildThisFileDirectory)build/Rikarin.Skala.Sdk.RuleIds.props" />
  </Target>

  <!--
    ⚠ The two .targets are copied into the package verbatim and are never parsed by this build, so
    nothing in them can be wrong until it is wrong on somebody else's machine — which happened to the
    MSBuild package's .props, as MSB4024 on the first build of the first repository that referenced
    it. XmlPeek fails on malformed XML, so asking it for the root element is a parse.
  -->
  <ItemGroup>
    <SkalaPackagedMSBuildFile Include="build/Rikarin.Skala.Sdk.targets" />
    <SkalaPackagedMSBuildFile Include="build/Rikarin.Skala.Sdk.RuleIds.props" />
    <SkalaPackagedMSBuildFile Include="buildTransitive/Rikarin.Skala.Sdk.targets" />
  </ItemGroup>

  <Target Name="SkalaValidatePackagedMSBuildFiles" BeforeTargets="Build" Inputs="@(SkalaPackagedMSBuildFile)" Outputs="$(IntermediateOutputPath)msbuild-files-parse.stamp">
    <XmlPeek XmlInputPath="%(SkalaPackagedMSBuildFile.Identity)" Query="/Project" />
    <Touch Files="$(IntermediateOutputPath)msbuild-files-parse.stamp" AlwaysCreate="true" />
  </Target>

</Project>
