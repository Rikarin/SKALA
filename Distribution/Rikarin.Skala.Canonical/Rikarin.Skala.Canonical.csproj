<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Rikarin.Skala.Canonical</PackageId>
    <Description>The canonical .editorconfig shared across Rikarin repositories. Installed by `skala config sync`; verified by `skala config diff --canonical`.</Description>
    <PackageTags>editorconfig;formatting;skala</PackageTags>

    <!-- Content only: there is no code here and nothing to reference. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PackageMarker.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="canonical.editorconfig" Pack="true" PackagePath="content/" />
    <None Include="canonical.json" Pack="true" PackagePath="content/" />
    <None Include="build/Rikarin.Skala.Canonical.targets" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive/Rikarin.Skala.Canonical.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <ItemGroup>
    <SkalaPackagedMSBuildFile Include="build/Rikarin.Skala.Canonical.targets" />
    <SkalaPackagedMSBuildFile Include="buildTransitive/Rikarin.Skala.Canonical.targets" />
  </ItemGroup>
    
  <Target Name="SkalaValidatePackagedMSBuildFiles" BeforeTargets="Build" Inputs="@(SkalaPackagedMSBuildFile)" Outputs="$(IntermediateOutputPath)msbuild-files-parse.stamp">
    <XmlPeek XmlInputPath="%(SkalaPackagedMSBuildFile.Identity)" Query="/Project" />
    <Touch Files="$(IntermediateOutputPath)msbuild-files-parse.stamp" AlwaysCreate="true" />
  </Target>
</Project>
