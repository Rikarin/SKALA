            },
            {
              "id": "SK9021",
              "name": "BinlogMissingFile",
              "fullDescription": {
                "text": "A new file that the binlog does not name is invisible to every compilation and is therefore silently unanalysed, which is the worst failure this tool can have. It is a warning and not an info for exactly that reason."
              },
              "help": {
                "text": "A `.cs` file under the repository is in no recorded compilation. Rebuild."
              },
              "shortDescription": {
                "text": "The binlog does not name a file that exists"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Rikarin/Skala/blob/main/docs/rules/SK9021.md",
              "properties": {
                "defaultSeverity": "warning",
                "category": "Tool",
                "scope": "Compilation",
                "requiresSemantics": false,
                "hasFix": false,
                "fixIsSafe": false,
                "since": "0.6"
              }
            },
            {
              "id": "SK9030",
              "name": "AnalyzerThrew",
              "fullDescription": {
                "text": "A third-party analyzer that throws on one syntax shape must not be able to turn a CI gate red for unrelated reasons — or, worse, green by aborting the run early."
              },
              "help": {
                "text": "An analyzer raised an exception; it is disabled for the rest of the run and everything else continues."
              },
              "shortDescription": {
                "text": "An analyzer threw"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Rikarin/Skala/blob/main/docs/rules/SK9030.md",
              "properties": {
                "defaultSeverity": "warning",
                "category": "Tool",
                "scope": "Compilation",
                "requiresSemantics": false,
                "hasFix": false,
                "fixIsSafe": false,
                "since": "0.6"
              }
            },
            {
              "id": "SK9031",
              "name": "AnalyzerFailedToLoad",
              "fullDescription": {
                "text": "ADR-008: third-party rules are hosted, never bundled. A package that is missing, is for another framework, or drags a conflicting dependency is a configuration problem to report, not a reason to produce no report at all."
              },
              "help": {
                "text": "A hosted analyzer package named in `skala.jsonc` could not be loaded. Never fatal."
              },
              "shortDescription": {
                "text": "An analyzer package failed to load"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Rikarin/Skala/blob/main/docs/rules/SK9031.md",
              "properties": {
                "defaultSeverity": "warning",
                "category": "Tool",
                "scope": "Compilation",
                "requiresSemantics": false,
                "hasFix": false,
                "fixIsSafe": false,
                "since": "0.6"
              }
            },
            {
              "id": "SK9099",
              "name": "TokenStreamChanged",
              "fullDescription": {
                "text": "ADR-005. The check is one extra parse per file, it costs about 15 % of formatting time, and there is no flag that turns it off."
              },
              "help": {
                "text": "A Skala bug by definition. Nothing was written and a reproduction was dropped under `.skala/crash/`."
              },
              "shortDescription": {
                "text": "The formatter's output was not token-equivalent"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/Rikarin/Skala/blob/main/docs/rules/SK9099.md",
              "properties": {
                "defaultSeverity": "error",
                "category": "Tool",
                "scope": "Syntax",
                "requiresSemantics": false,
                "hasFix": false,
                "fixIsSafe": false,
                "since": "0.2"
              }
            }
