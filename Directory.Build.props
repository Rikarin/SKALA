<Project>

  <!--
    Shared identity and the two MSBuild profiles from docs/plan/02-repository-layout.md.

    Profile selection is by project name, following Vixen's pattern:
      *.Rules, *.Generator  ->  analyzer profile (netstandard2.0, loaded into csc and Rider)
      everything else       ->  tool profile     (net10.0)
  -->

  <PropertyGroup>
    <SkalaRepositoryRoot>$(MSBuildThisFileDirectory)</SkalaRepositoryRoot>
    <Product>Skala</Product>
    <Company>Rikarin</Company>
    <Authors>Rikarin</Authors>
    <Copyright>Copyright (c) Rikarin</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Rikarin/Skala</RepositoryUrl>
    <!--
      ⚠ **The one place a Skala version is written down.** docs/plan/18-versioning-and-release.md
      § "One source of truth". The release workflow overrides `Version` from the number
      `skala-release plan` measures; it never edits this file, and nothing else in the tree carries
      a number that would have to agree. `VersionSourcesTests` in Rikarin.Skala.Core.Tests is what
      keeps a second one from appearing — including the `since` fields in `rules.json` and
      `options.json`, which are versions and were claiming `1.2` while this said `1.0.0`.

      ⚠ **2.0.0, and it was measured rather than chosen.** M7 declared 1.0 on the strength of four
      frozen surfaces (doc 02 § "Repository policy"). Run against the tree that declared it, the
      release detectors report that one of the four moved 125 commits later: a `format` check over
      an unformatted file exited **1** at 1.0.0 and exits **2** now, and a path that does not exist
      went from 0 to 3. `dotnet_style_require_accessibility_modifiers` also changed type. Those are
      major by doc 18's table, so the number is 2.0.0. Nothing was ever published under 1.0.0, which
      is why this costs nobody anything, and why doc 18 § "Why the first published artefact is a
      pre-release" makes the first one `2.0.0-alpha.N` rather than `2.0.0`.

      ⚠ **VersionSuffix is the local default, not the release counter.** CI derives `alpha.N` from
      the commit count since the baseline tag, so a `master` build is reconstructible from the
      repository alone.

      ⚠ No double hyphen anywhere in this comment, and that is not a style choice: XML forbids one
      inside a comment, and `Directory.Build.props` failing to parse takes every project in the tree
      with it. The Sdk package's .csproj carries the same warning for the same reason.
    -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    ⚠ NuGet audit, and it applies to _build as well — deliberately outside the block below, which
    exempts _build from TreatWarningsAsErrors. That exemption is exactly why Nuke.Common's
    System.Security.Cryptography.Xml 9.0.0 (seven high advisories) sat in this repository unnoticed
    until M7 measured it. A static-analysis tool shipping known vulnerabilities in its own build has
    an argument to lose, so the audit is an error for every project including the one nobody looks at.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != '_build'">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      The repository's own .editorconfig is the Rider export (ADR-015). It carries 253
      dotnet_diagnostic severities and ~40 csharp_style_* keys with inline severities. Those
      configure the IDE; letting them also drive the build would make `dotnet build` a second
      code-style gate beside `skala check`. Skala hosts the one external code-style rule it promises,
      IDE1006, directly; ordinary builds intentionally leave the SDK's full IDE rule set disabled.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Analyzer-shared profile: *.Rules.Metadata. netstandard2.0 like the analyzer profile, because
    Rikarin.Skala.Rules references it and that assembly loads into csc and into Rider — but it is an
    ordinary library rather than a Roslyn component, so it is packed and it has no analyzer wiring.
    ⚠ This block must come before the analyzer block: '.Rules.Metadata' does not end with '.Rules',
    but the tool block below keys on SkalaProfile being empty and would otherwise claim it.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Rules.Metadata'))">
    <SkalaProfile>analyzer-shared</SkalaProfile>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Analyzer profile: *.Rules, *.Generator -->
  <PropertyGroup Condition="'$(SkalaProfile)' == '' and ($(MSBuildProjectName.EndsWith('.Rules')) or $(MSBuildProjectName.EndsWith('.Generator')))">
    <SkalaProfile>analyzer</SkalaProfile>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Tool profile: everything else -->
  <PropertyGroup Condition="'$(SkalaProfile)' == '' and '$(MSBuildProjectName)' != '_build'">
    <SkalaProfile>tool</SkalaProfile>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <SkalaIsTestProject>true</SkalaIsTestProject>
    <OutputType>Exe</OutputType>
    <!--
      docs/plan/02 § "Naming" mandates Method_Condition_Expectation for test names, which is
      exactly what CA1707 forbids. The naming convention wins; it is the one a reader benefits from.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
