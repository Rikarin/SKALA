<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The option registry. options.json is the single source of truth; every C# type in this
    assembly other than the hand-written value model is generated from it.
  -->

  <PropertyGroup>
    <RootNamespace>Rikarin.Skala.Options</RootNamespace>
    <!-- The generated option model is the assembly's entire public surface; being able to read it matters. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rikarin.Skala.Options.Generator/Rikarin.Skala.Options.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="options.json" />
    <!-- Shipped so the CLI can report registry provenance without a build. -->
    <EmbeddedResource Include="options.json" LogicalName="Rikarin.Skala.Options.options.json" />
  </ItemGroup>

</Project>
